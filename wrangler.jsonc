{
  "name": "nexuskratos-website",
  "main": "worker/redirect.mjs",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "nexuskratos.dev",
      "custom_domain": true
    },
    {
      "pattern": "www.nexuskratos.dev",
      "custom_domain": true
    },
    {
      "pattern": "nexuskratos.com",
      "custom_domain": true
    },
    {
      "pattern": "www.nexuskratos.com",
      "custom_domain": true
    }
  ]
}
